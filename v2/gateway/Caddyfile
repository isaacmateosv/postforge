{
    admin off
    auto_https off
}

:8080 {
    @unexpected not host {$POSTFORGE_GATEWAY_HOST}
    route {
        respond @unexpected 421

        # Crawlers must discover that signed media is fetchable without a browser login.
        # This policy grants no access: signatures and expiry are still verified below.
        @robots path /robots.txt
        handle @robots {
            header Content-Type "text/plain; charset=utf-8"
            respond `User-agent: *
Allow: /postforge-media/
Disallow: /

User-agent: facebookexternalhit
User-agent: Facebot
User-agent: meta-externalfetcher
Allow: /postforge-media/
Disallow: /
` 200
        }

        @portal path /authelia /authelia/*
        handle @portal {
            reverse_proxy postforge-auth:9091 {
                header_up X-Forwarded-Proto https
            }
        }

        @signedMedia path_regexp signedMedia ^/postforge-media/[0-9]{10}/[a-f0-9]{64}(/uploads/.*)$
        handle @signedMedia {
            route {
                forward_auth postforge-media-auth:8081 {
                    uri /verify
                }
                rewrite * {re.signedMedia.1}
                header Cache-Control "private, no-store"
                header X-Robots-Tag "noindex, nofollow, noarchive"
                reverse_proxy postiz:5000 {
                    header_up -Cookie
                    header_up -Authorization
                    header_up -Proxy-Authorization
                    header_up -X-Forwarded-Uri
                }
            }
        }

        handle {
            forward_auth postforge-auth:9091 {
                uri /api/authz/forward-auth
                header_up X-Forwarded-Proto https
            }
            reverse_proxy postiz:5000 {
                header_up X-Forwarded-Proto https
                header_up -Proxy-Authorization
                header_up Cookie "(^|;[[:space:]]*)postforge_gateway=[^;]*" "${1}postforge_gateway=_"
            }
        }
    }
}
