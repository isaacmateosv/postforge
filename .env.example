# PostForge settings. Copy to .env, fill in the blanks, then `chmod 600 .env`.
# No spaces in values: postforge.sh/publish-machine.sh sources this file. Secrets stay empty here.
# `./postforge.sh doctor` checks that the required names are set.

# --- Postiz (read by the pm-postiz container) ---------------------------------------------
NODE_ENV=production
# Public URL of Postiz: the ngrok domain. Social apps' redirect URLs are built from it.
FRONTEND_URL=https://<NGROK_DOMAIN>
NEXT_PUBLIC_BACKEND_URL=https://<NGROK_DOMAIN>/api
# Also the public URL (docker-compose passes FRONTEND_URL as MAIN_URL anyway).
MAIN_URL=https://<NGROK_DOMAIN>
# Long random string that signs Postiz logins. Keep the old one when moving machines.
JWT_SECRET=
DATABASE_URL=postgresql://postiz:<POSTGRES_PASSWORD>@postgres:5432/postiz
REDIS_URL=redis://redis:6379
BACKEND_INTERNAL_URL=http://localhost:3000
IS_GENERAL=true
STORAGE_PROVIDER=local
# Must match the bind mount ./data/postiz-uploads:/uploads in docker-compose.yml.
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/uploads
TEMPORAL_ADDRESS=temporal:7233
# true: no new Postiz accounts once one exists (the public URL is reachable by anyone).
DISABLE_REGISTRATION=true
# Social channels (docs/reconnect/channel-setup.md), all optional: FACEBOOK_APP_ID, FACEBOOK_APP_SECRET,
# INSTAGRAM_APP_ID, INSTAGRAM_APP_SECRET, TIKTOK_CLIENT_ID, TIKTOK_CLIENT_SECRET,
# YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET, THREADS_APP_ID, THREADS_APP_SECRET.
# Meta scopes Postiz requests that Meta's login no longer accepts (README Gotcha #21). Space-separated
# old=new pairs: old=new renames a scope, old= drops it. instagram_manage_insights got "Invalid Scopes"
# on 2026-10-31, so Instagram stats stay off until its current name goes here (then reconnect
# Instagram in Postiz). After a change: docker compose up -d postiz.
PM_META_SCOPE_FIX="instagram_manage_insights="

# --- Databases (docker-compose) ------------------------------------------------------------
POSTGRES_USER=postiz
POSTGRES_PASSWORD=
POSTGRES_DB=postiz

# --- Tunnel (docker-compose, ngrok container) ----------------------------------------------
NGROK_AUTHTOKEN=
# The free plan's static domain, e.g. something.ngrok-free.dev (only one machine may use it).
NGROK_DOMAIN=

# --- WhatsApp (Evolution API container and scripts) ----------------------------------------
# API key for Evolution and its manager (http://localhost:8080/manager).
AUTHENTICATION_API_KEY=
WA_INSTANCE=status-engine
# Comma-separated numbers with country code, no +: the default `--to test` audience.
WA_TEST_RECIPIENTS=
# Default approved WhatsApp Status audience: all contacts (public) or test (private testing).
WA_STATUS_AUDIENCE=all
# Bound base64 memory in Evolution. Large videos should enter through the Mac window.
# Effective range 1–64 MiB; default 32 MiB.
WA_MAX_MEDIA_MB=32
# Optional: country code for numbers saved without one (default 593).
# WA_DEFAULT_COUNTRY_CODE=593

# --- Captions (scripts) --------------------------------------------------------------------
LOCAL_LLM_MODEL=llama3.2:3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Gemini is off unless this is true (switched off 2026-10-31 after a Google policy warning).
GEMINI_ENABLED=false
# Optional: GEMINI_THINKING_LEVEL (default low), CAPTION_LANGUAGE, OLLAMA_HOST_URL
# (default http://localhost:11434).
# Optional: TikTok drafts default to UPLOAD (to your TikTok inbox, where you finish and publish within
# 24 h). After TikTok audits the app: TIKTOK_POSTING_METHOD=DIRECT_POST, TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE.
# Optional: the fixed order line create-draft.sh adds under every caption (defaults in create_draft.py):
# CAPTION_CTA_ES=Escríbenos para más información.
# CAPTION_CTA_EN=Contact us for more information.

# --- Scripts and the menu bar app ----------------------------------------------------------
POSTIZ_LOCAL_URL=http://localhost:4200
# true: Turn Off also quits Docker Desktop, so its VM gives the memory back. Leave it false while
# other containers use Docker on that Mac.
# PM_QUIT_DOCKER_ON_STOP=true
# Days ahead the menu bar starts warning that a Facebook or Instagram connection will expire
# (they last 60 days and can't renew themselves; docs/reconnect/). Default 10.
# PM_CHANNEL_WARN_DAYS=10
# Minutes before the next queued post when macOS should wake (default 15).
# PM_WAKE_LEAD_MINUTES=15

# Read by nothing in this project (checked 2026-10-30), kept only in old copies of .env:
# TUNNEL_TOKEN, EVOLUTION_API_KEY, OLLAMA_BASE_URL.

# Saved file history age; cleanup is previewed and applied explicitly, not automatic deletion.
PM_RETENTION_DAYS=30
