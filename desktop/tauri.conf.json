{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PostForge Desktop",
  "version": "2.0.0-rc.23",
  "identifier": "local.postforge.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PostForge Desktop",
        "width": 1120,
        "height": 880,
        "minWidth": 720,
        "minHeight": 600,
        "maximized": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../docs/images/postforge-mark.png",
      "icons/icon.ico"
    ]
  }
}
